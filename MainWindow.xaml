
<Window x:Class="RobotFleetSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Fleet Simulation"
        Height="800"
        Width="1400"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#10141D"
        Foreground="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#191F2C"
                Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="ROBOT FLEET / Simulation Dashboard"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#60A5FA"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">
                    <Button Content="Start"
                            Click="StartSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Pause"
                            Click="PauseSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Reset"
                            Click="ResetSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#151B26"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="WORKSPACE"
                               Foreground="#94A3B8"
                               Margin="4,12"/>
                    <TextBlock Text="Warehouse Map" Margin="4,8"/>
                    <TextBlock Text="Robots" Margin="4,8"/>
                    <TextBlock Text="Tasks" Margin="4,8"/>
                    <TextBlock Text="Path Planning" Margin="4,8"/>
                    <TextBlock Text="Analytics" Margin="4,8"/>
                </StackPanel>
            </Border>

            <!-- Warehouse -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Warehouse Overview"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="8,8,8,16"/>

                <!-- Dashboard statistics -->
                <UniformGrid Grid.Row="1" Columns="5">

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Total Robots"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="TotalRobotsValue"
                                       Text="3"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Active Robots"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="ActiveRobotsValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#34D399"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Pending Tasks"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="PendingTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#FBBF24"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="In Progress"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="InProgressTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#F97316"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Completed"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="CompletedTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#60A5FA"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Warehouse map editor -->
                <Border Grid.Row="2"
                        Background="#191F2C"
                        CornerRadius="10"
                        Padding="12"
                        Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Warehouse Map Editor"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="4,4,4,12"/>

                        <WrapPanel Grid.Row="1"
                                   Margin="0,0,0,8">
                            <Button Content="Wall"
                                    Click="WallMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Robot Start"
                                    Click="RobotStartMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Destination"
                                    Click="DestinationMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Erase"
                                    Click="EraseMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                        </WrapPanel>

                        <Border Grid.Row="2"
                                Background="#111827"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid x:Name="WarehouseHost"
                                  ClipToBounds="True"/>
                        </Border>

                        <TextBlock x:Name="SelectionLabel"
                                   Grid.Row="3"
                                   Text="Choose a tool, then click a grid cell."
                                   Foreground="#94A3B8"
                                   Margin="4,10,4,2"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right panel -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Robot Fleet -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Robot Fleet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Registered robots"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,8"/>

                            <ListBox x:Name="RobotFleetList"
         MinHeight="90"
         MaxHeight="180"
         Background="#111827"
         Foreground="#F1F5F9"
         BorderThickness="0"
         SelectionChanged="RobotFleetList_SelectionChanged"/>

                            <Button Content="Add Robot"
                                    Click="AddRobot_Click"
                                    Padding="10,7"
                                    Margin="0,10,0,0"/>

                            <TextBlock x:Name="RobotFleetMessageText"
                                       Text="Fleet initialized."
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected Robot -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Selected Robot"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Robot-01"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Position"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="RobotPositionText"
                                       Text="Row: --  Col: --"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Status"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="RobotStatusText"
                                       Text="Idle"
                                       Foreground="#34D399"
                                       Margin="0,4,0,10"/>

                            <TextBlock x:Name="StepsTakenText"
                                       Text="Steps Taken: 0"
                                       Margin="0,6,0,0"/>

                            <TextBlock x:Name="RouteLengthText"
                                       Text="Route Length: 0"
                                       Margin="0,4,0,10"/>

                            <!-- Battery -->
                            <TextBlock Text="Battery"
                                       Foreground="#94A3B8"/>

                            <ProgressBar x:Name="BatteryProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="100"
                                         Height="10"
                                         Margin="0,8"/>

                            <TextBlock x:Name="BatteryPercentageText"
                                       Text="100%"
                                       Foreground="#34D399"
                                       Margin="0,0,0,8"/>

                            <Button Content="Recharge Battery"
                                    Click="RechargeBattery_Click"
                                    Padding="10,6"
                                    Margin="0,4,0,8"/>

                            <!-- Simulation speed -->
                            <TextBlock Text="Simulation Speed"
                                       Foreground="#94A3B8"
                                       Margin="0,12,0,4"/>

                            <Slider x:Name="SimulationSpeedSlider"
                                    Minimum="50"
                                    Maximum="1000"
                                    Value="300"
                                    TickFrequency="50"
                                    ValueChanged="SimulationSpeedSlider_ValueChanged"
                                    Margin="0,4"/>

                            <TextBlock x:Name="SimulationSpeedText"
                                       Text="300 ms per step"
                                       Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Create Task -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Create Task"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Task name"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskNameInput"
                                     Text="Delivery Task"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <TextBlock Text="Destination row (0–19)"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskRowInput"
                                     Text="10"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <TextBlock Text="Destination column (0–29)"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskColumnInput"
                                     Text="20"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <Button Content="Add Task"
                                    Click="AddTask_Click"
                                    Padding="10,8"
                                    Margin="0,4,0,8"/>

                            <TextBlock x:Name="TaskMessageText"
                                       Text="Enter a destination to create a task."
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Task Queue -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Task Queue"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="TaskList"
                                     MinHeight="120"
                                     MaxHeight="250"
                                     Background="#111827"
                                     Foreground="#F1F5F9"
                                     BorderThickness="0"/>

                            <TextBlock Text="Tasks are processed in queue order."
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#191F2C"
                Padding="12,4">
            <DockPanel>
                <TextBlock Text="Ready"
                           Foreground="#34D399"/>

                <TextBlock Text=".NET 10 | WPF"
                           DockPanel.Dock="Right"
                           Foreground="#94A3B8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
