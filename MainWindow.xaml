
<Window x:Class="RobotFleetSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Fleet Simulation"
        Height="900"
        Width="1580"
        MinHeight="740"
        MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#10141D"
        Foreground="#F1F5F9">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#243247"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3B4D65"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#334A67"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0D1522"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#34445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#172233"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#34445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#0D1522"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#27364A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25364D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#191F2C"
                Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="ROBOT FLEET / Simulation Dashboard"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#60A5FA"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">
                    <Button Content="Start"
                            Click="StartSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Pause"
                            Click="PauseSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Reset"
                            Click="ResetSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Step"
                            Click="StepSimulation_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Save"
                            Click="SaveScenario_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Load"
                            Click="LoadScenario_Click"
                            Margin="4"
                            Padding="12,6"/>
                    <Button Content="Export report"
                            Click="ExportReport_Click"
                            Margin="4"
                            Padding="12,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#151B26"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="WORKSPACE"
                               Foreground="#94A3B8"
                               Margin="4,12"/>
                    <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2,0,0,0" CornerRadius="5" Padding="9,8" Margin="1,2,1,12">
                        <StackPanel>
                            <TextBlock Text="WAREHOUSE MAP" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="MapDimensionsText" Text="Fixed 60 × 80 · 4,800 cells" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="MAP LEGEND" Foreground="#94A3B8" Margin="4,5,4,8" FontSize="10" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#784A2A" RadiusX="2" RadiusY="2"/><TextBlock Text="  Storage rack" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#108273" RadiusX="5" RadiusY="5"/><TextBlock Text="  Charging bay" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#2563EB" RadiusX="2" RadiusY="2"/><TextBlock Text="  Loading dock" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#DB702A" RadiusX="2" RadiusY="2"/><TextBlock Text="  Packing station" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#167089" RadiusX="2" RadiusY="2"/><TextBlock Text="  One-way lane" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4"><Rectangle Width="11" Height="11" Fill="#EF4444" RadiusX="2" RadiusY="2"/><TextBlock Text="  Congestion" FontSize="12"/></StackPanel>
                    <Separator Margin="2,14,2,8" Background="#334155"/>
                    <TextBlock Text="SHORTCUTS" Foreground="#94A3B8" Margin="4,4" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="F5   Start fleet" Margin="4,4" FontSize="12"/>
                    <TextBlock Text="Esc   Pause fleet" Margin="4,4" FontSize="12"/>
                    <TextBlock Text="Ctrl + →   Step" Margin="4,4" FontSize="12"/>
                    <TextBlock Text="Ctrl + Z / Y   Undo / redo" Margin="4,4" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Warehouse -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Warehouse Overview"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="8,8,8,16"/>

                <!-- Dashboard statistics -->
                <UniformGrid Grid.Row="1" Columns="5">

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Total Robots"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="TotalRobotsValue"
                                       Text="3"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Active Robots"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="ActiveRobotsValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#34D399"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Pending Tasks"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="PendingTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#FBBF24"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="In Progress"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="InProgressTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#F97316"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="4"
                            Padding="8"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Completed"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="CompletedTasksValue"
                                       Text="0"
                                       FontSize="24"
                                       Foreground="#60A5FA"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Warehouse map editor -->
                <Border Grid.Row="3"
                        Background="#191F2C"
                        CornerRadius="10"
                        Padding="12"
                        Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Warehouse Map Editor"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="4,4,4,12"/>

                        <WrapPanel Grid.Row="1"
                                   Margin="0,0,0,8">
                            <Button Content="Wall"
                                    Click="WallMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Robot Start"
                                    Click="RobotStartMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Destination"
                                    Click="DestinationMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Erase"
                                    Click="EraseMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Shelves"
                                    Click="ShelfMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Charge pad"
                                    Click="ChargingMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Slow zone"
                                    Click="SlowZoneMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Dock"
                                    Click="DockMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Packing"
                                    Click="PackingMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Elevator"
                                    Click="ElevatorMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Restricted"
                                    Click="RestrictedMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="One-way ↑"
                                    Click="OneWayNorthMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="One-way →"
                                    Click="OneWayEastMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="One-way ↓"
                                    Click="OneWaySouthMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="One-way ←"
                                    Click="OneWayWestMode_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Undo"
                                    Click="UndoMap_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                            <Button Content="Redo"
                                    Click="RedoMap_Click"
                                    Padding="10,5"
                                    Margin="3"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Border Background="#172233" BorderBrush="#34445A" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="3" VerticalAlignment="Center">
                                <TextBlock Text="GRID LOCKED · 60 × 80" Foreground="#93C5FD" FontWeight="SemiBold"/>
                            </Border>
                            <ComboBox x:Name="PresetPicker" Width="145" SelectedIndex="0" Margin="3" Padding="4"/>
                            <Button Content="Load preset" Click="LoadPreset_Click" Padding="8,4" Margin="3"/>
                            <ComboBox x:Name="DispatchStrategyPicker" Width="155" SelectedIndex="0" Margin="3" Padding="4"/>
                            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="4"/>
                            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="200" Value="100" Width="112" ValueChanged="ZoomSlider_ValueChanged" ToolTip="Zoom map from 10% to 200% while keeping its center in view"/>
                            <TextBlock x:Name="ZoomPercentText" Text="100%" VerticalAlignment="Center" MinWidth="42" Margin="4,0" Foreground="#CBD5E1"/>
                        </WrapPanel>

                        <Border Grid.Row="3"
                                Background="#111827"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="MapScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False">
                                <Grid x:Name="WarehouseHost" ClipToBounds="True"/>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectionLabel"
                                   Grid.Column="0"
                                   Text="Choose a tool, then click a grid cell."
                                   Foreground="#94A3B8"
                                   Margin="4,10,4,2"
                                   TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="History" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0"/>
                            <Slider x:Name="ReplaySlider" Grid.Column="2" Minimum="0" Maximum="0" Value="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ReplaySlider_ValueChanged" ToolTip="Scrub the simulation history" Margin="8,8,2,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right panel -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Robot Fleet -->
                    <Border Background="#191F2C" Margin="5" Padding="12" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Battery trend · selected robot" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <Canvas x:Name="BatteryChart" Height="58" Background="#111827" SizeChanged="BatteryChart_SizeChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Robot Fleet"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Registered robots"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,8"/>

                            <ListBox x:Name="RobotFleetList"
         MinHeight="90"
         MaxHeight="180"
         Background="#111827"
         Foreground="#F1F5F9"
         BorderThickness="0"
         SelectionChanged="RobotFleetList_SelectionChanged"/>

                            <Button Content="Add Robot"
                                    Click="AddRobot_Click"
                                    Padding="10,7"
                                    Margin="0,10,0,0"/>
                            <Button Content="Apply selected robot capabilities"
                                    Click="ApplyRobotCapabilities_Click"
                                    Padding="8,6"
                                    Margin="0,6,0,0"/>
                            <TextBox x:Name="RobotSpeedInput" Text="1" ToolTip="Cells per simulation tick (0.25–3)" Margin="0,5,0,2" Padding="5"/>
                            <TextBox x:Name="RobotPayloadCapacityInput" Text="25" ToolTip="Payload capacity in kilograms" Margin="0,2,0,2" Padding="5"/>
                            <TextBox x:Name="RobotBatteryCapacityInput" Text="100" ToolTip="Battery capacity units" Margin="0,2,0,2" Padding="5"/>
                            <TextBlock Text="Speed (cells/tick), payload capacity (kg), battery capacity" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>

                            <TextBlock x:Name="RobotFleetMessageText"
                                       Text="Fleet initialized."
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected Robot -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Selected Robot"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock x:Name="SelectedRobotNameText" Text="Robot-01"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Position"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="RobotPositionText"
                                       Text="Row: --  Col: --"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Status"
                                       Foreground="#94A3B8"/>
                            <TextBlock x:Name="RobotStatusText"
                                       Text="Idle"
                                       Foreground="#34D399"
                                       Margin="0,4,0,10"/>
                            <TextBlock x:Name="RobotCapabilityText"
                                       Text="Speed 1 · Payload 25 kg"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="StepsTakenText"
                                       Text="Steps Taken: 0"
                                       Margin="0,6,0,0"/>

                            <TextBlock x:Name="RouteLengthText"
                                       Text="Route Length: 0"
                                       Margin="0,4,0,10"/>

                            <!-- Battery -->
                            <TextBlock Text="Battery"
                                       Foreground="#94A3B8"/>

                            <ProgressBar x:Name="BatteryProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="100"
                                         Height="10"
                                         Margin="0,8"/>

                            <TextBlock x:Name="BatteryPercentageText"
                                       Text="100%"
                                       Foreground="#34D399"
                                       Margin="0,0,0,8"/>

                            <Button Content="Recharge Selected Robot"
                                    Click="RechargeBattery_Click"
                                    Padding="10,6"
                                    Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Content="Pause selected"
                                        Click="PauseSelectedRobot_Click"
                                        Padding="8,5"
                                        Margin="0,2,6,4"/>
                                <Button Content="Resume selected"
                                        Click="ResumeSelectedRobot_Click"
                                        Padding="8,5"
                                        Margin="0,2,0,4"/>
                            </WrapPanel>

                            <!-- Simulation speed -->
                            <TextBlock Text="Simulation Speed"
                                       Foreground="#94A3B8"
                                       Margin="0,12,0,4"/>

                            <Slider x:Name="SimulationSpeedSlider"
                                    Minimum="50"
                                    Maximum="1000"
                                    Value="300"
                                    TickFrequency="50"
                                    ValueChanged="SimulationSpeedSlider_ValueChanged"
                                    Margin="0,4"/>

                            <TextBlock x:Name="SimulationSpeedText"
                                       Text="300 ms per step"
                                       Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Create Task -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Create Task"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Task name"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskNameInput"
                                     Text="Delivery Task"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <TextBlock Text="Destination row"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskRowInput"
                                     Text="10"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <TextBlock Text="Destination column"
                                       Foreground="#94A3B8"/>

                            <TextBox x:Name="TaskColumnInput"
                                     Text="20"
                                     Margin="0,5,0,10"
                                     Padding="6"/>

                            <TextBlock Text="Priority (1–5)"
                                       Foreground="#94A3B8"/>
                            <ComboBox x:Name="TaskPriorityInput"
                                      SelectedIndex="2"
                                      Margin="0,5,0,10"
                                      Padding="6">
                                <ComboBoxItem Content="1 — Low"/>
                                <ComboBoxItem Content="2 — Normal"/>
                                <ComboBoxItem Content="3 — High"/>
                                <ComboBoxItem Content="4 — Urgent"/>
                                <ComboBoxItem Content="5 — Critical"/>
                            </ComboBox>
                            <TextBlock Text="Deadline minutes (0 = none)"
                                       Foreground="#94A3B8"/>
                            <TextBox x:Name="TaskDeadlineInput"
                                     Text="0"
                                     Margin="0,5,0,10"
                                     Padding="6"/>
                            <TextBlock Text="Task type" Foreground="#94A3B8"/>
                            <ComboBox x:Name="TaskTypeInput" SelectedIndex="2" Margin="0,5,0,10" Padding="6">
                                <ComboBoxItem Content="Move"/><ComboBoxItem Content="Pickup"/><ComboBoxItem Content="Delivery"/><ComboBoxItem Content="Charge"/><ComboBoxItem Content="Multi-stop"/>
                            </ComboBox>
                            <TextBlock Text="Payload weight (kg)" Foreground="#94A3B8"/>
                            <TextBox x:Name="TaskPayloadInput" Text="0" Margin="0,5,0,10" Padding="6"/>
                            <TextBlock Text="Extra stops: row,col; row,col" Foreground="#94A3B8"/>
                            <TextBox x:Name="TaskStopsInput" Text="" ToolTip="Optional intermediate stops, for example 4,5; 8,10" Margin="0,5,0,10" Padding="6"/>

                            <Button Content="Add Task"
                                    Click="AddTask_Click"
                                    Padding="10,8"
                                    Margin="0,4,0,8"/>

                            <TextBlock x:Name="TaskMessageText"
                                       Text="Enter a destination to create a task."
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Task Queue -->
                    <Border Background="#191F2C"
                            Margin="5"
                            Padding="14"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Task Queue"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="TaskList"
                                     MinHeight="120"
                                     MaxHeight="250"
                                     Background="#111827"
                                     Foreground="#F1F5F9"
                                     BorderThickness="0"/>

                            <Button Content="Cancel selected task"
                                    Click="CancelTask_Click"
                                    Padding="8,6"
                                    Margin="0,8,0,0"/>
                            <Button Content="Reassign selected task"
                                    Click="ReassignTask_Click"
                                    Padding="8,6"
                                    Margin="0,5,0,0"/>

                            <TextBlock Text="Tasks are assigned by priority, then nearest reachable robot."
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Simulation event log" Foreground="#94A3B8" Margin="0,10,0,4"/>
                            <ListBox x:Name="EventLogList" MinHeight="65" MaxHeight="150" Background="#111827" Foreground="#CBD5E1" BorderThickness="0" FontSize="10"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#191F2C"
                Padding="12,4">
